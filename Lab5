            string n,d,p,a; cin>>ws; getline(cin,n); getline(cin,d); getline(cin,p); getline(cin,a);
            L.Modify(k,n,d,p,a);
        } else if(ch==10){
            L.Add(readEmp());
        } else if(ch==11){
