    return new Emp(id,name,dob,phone,address);
}

int main(){
    EmpLinkedList L;
    int ch;
    do{
        menu();
        cout<<"Choice: ";
        if(!(cin>>ch)) break;
        if(ch==1){
            auto *f=L.Front(); if(!f) cout<<"[Empty]\n";
            else cout<<f->id<<" | "<<f->name<<" | "<<f->dob<<" | "<<f->phone<<" | "<<f->address<<'\n';
        } else if(ch==2){
            auto *b=L.Back(); if(!b) cout<<"[Empty]\n";
            else cout<<b->id<<" | "<<b->name<<" | "<<b->dob<<" | "<<b->phone<<" | "<<b->address<<'\n';
        } else if(ch==3){
            L.Print_List();
        } else if(ch==4){
            L.AddFront(readEmp());
        } else if(ch==5){
            L.AddBack(readEmp());
        } else if(ch==6){
            L.DeleteFront();
        } else if(ch==7){
            L.DeleteBack();
        } else if(ch==8){
            int k; cout<<"Find ID: "; cin>>k;
            if(auto *e=L.Find(k)) cout<<"Found: "<<e->name<<'\n'; else cout<<"Not found\n";
        } else if(ch==9){
            int k; cout<<"Modify ID: "; cin>>k;
