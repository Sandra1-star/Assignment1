        } else if(ch==12){
            cout<<"Employees: "<<L.Count()<<'\n';
        } else if(ch==0){
            cout<<"Bye\n";
        } else {
            cout<<"Invalid\n";
        }
    }
while(ch!=0);
    return 0;
}
